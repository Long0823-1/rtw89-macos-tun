#!/bin/bash
# stop a previous installation before files are replaced
launchctl bootout system /Library/LaunchDaemons/local.rtw89d.plist 2>/dev/null || true
U=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$U" ] && [ "$U" != root ]; then
  launchctl bootout "gui/$(id -u "$U")/local.rtw89.wifi" 2>/dev/null || true
fi
pkill -x RTW89WiFi 2>/dev/null || true
exit 0
